# Generate with: modelshelf-server hash-password (or: modelshelf hash-password)
MODELSHELF_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$replace$replace'
# Replace with at least 32 random bytes. This signs Web UI sessions.
MODELSHELF_SESSION_SECRET=replace-with-at-least-32-random-bytes
MODELSHELF_SESSION_COOKIE_SECURE=false
# Public browser-facing origin/path used in the generated client installer command.
MODELSHELF_PUBLIC_BASE_URL=
# Anonymous users can browse/search published artifact metadata by default.
MODELSHELF_PUBLIC_ARTIFACTS=true
# Comma-separated CLI API tokens. These are separate from the Web UI password.
MODELSHELF_WRITE_TOKENS=replace-with-a-long-random-token

# Maximum ingestion tasks running across the server and for any one source respectively.
# These limits are separate from the provider SDK's internal per-file concurrency.
MODELSHELF_MAX_CONCURRENT_DOWNLOADS=2
MODELSHELF_MAX_CONCURRENT_DOWNLOADS_PER_SOURCE=1

# Comma-separated server-local directories that may be imported. Mount them read-only.
MODELSHELF_IMPORT_ROOTS=

# Optional outbound routing. Mirrors are provider-specific; the HTTP(S) proxy applies to all hubs.
MODELSHELF_HUGGINGFACE_MIRROR=
# Optional mirrors are source-specific because ModelScope CN and AI are separate sites.
MODELSHELF_MODELSCOPE_CN_MIRROR=
MODELSHELF_MODELSCOPE_AI_MIRROR=
MODELSHELF_HTTP_PROXY=

# Real Ganesha/system NFS listen port. Bare-metal deployments must configure Ganesha to match.
# Docker Compose deliberately overrides this to the fixed container-internal port 2049.
MODELSHELF_NFS_PORT=2049
# Client-visible endpoint published through /api/v1/info and shown in integration examples.
# HOST is required to enable NFS discovery; use an address reachable from client machines.
MODELSHELF_NFS_ADVERTISED_HOST=192.168.1.10
# PORT is optional. Empty means "reuse MODELSHELF_NFS_PORT". Set it only when clients connect
# through a different port. In Compose, that value is also mapped to container port 2049.
MODELSHELF_NFS_ADVERTISED_PORT=
# Comma-separated client CIDRs. Public CIDRs require the explicit opt-in below.
MODELSHELF_NFS_CLIENTS=192.168.0.0/16,10.0.0.0/8
MODELSHELF_NFS_ALLOW_PUBLIC=false

# Optional provider credentials
HF_TOKEN=
# ModelScope CN and AI tokens are not interchangeable. Leave either empty for public models.
MODELSCOPE_CN_API_TOKEN=
MODELSCOPE_AI_API_TOKEN=
KAGGLE_API_TOKEN=
GITHUB_TOKEN=
