NFS_Core_Param {
    Protocols = 4;
    Enable_UDP = false;
    Clustered = false;
    NFS_Port = 2049;
    Enable_NLM = false;
    Enable_RQUOTA = false;
    # Ganesha 6.x uses PR_SET_IO_FLUSHER. The exporter runs in a constrained
    # container and is never mounted back on its own host, so startup may
    # continue if the container namespace cannot grant this prctl.
    Allow_Set_Io_Flusher_Fail = true;
}

EXPORT {
    Export_Id = 1;
    Path = /export/artifacts;
    Pseudo = /modelshelf;
    Access_Type = RO;
    Protocols = 4;
    Transports = TCP;
    SecType = sys;
    Squash = Root_Squash;
    # Artifacts are atomically published by the separate ModelShelf process.
    # Expire attributes immediately and do not trust negative readdir cache
    # entries so newly renamed artifacts become visible without disabling the
    # directory chunk cache recommended by Ganesha.
    Attr_Expiration_Time = 0;
    Trust_Readdir_Negative_Cache = false;

    CLIENT {
        Clients = __CLIENTS__;
        Access_Type = RO;
        Protocols = 4;
        Transports = TCP;
        SecType = sys;
    }

    FSAL {
        Name = VFS;
    }
}

LOG {
    Default_Log_Level = EVENT;
    Components {
        ALL = EVENT;
    }
    Facility {
        name = STDERR;
        destination = STDERR;
        enable = active;
    }
}
