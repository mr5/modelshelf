NFS_Core_Param {
    Protocols = 4;
    Enable_UDP = false;
    Clustered = false;
    NFS_Port = 2049;
    Enable_NLM = false;
    Enable_RQUOTA = false;
}

EXPORT {
    Export_Id = 1;
    Path = /export/artifacts;
    Pseudo = /modelshelf;
    Access_Type = RO;
    Protocols = 4;
    Transports = TCP;
    SecType = sys;
    Squash = Root_Squash;
    # Artifacts are atomically published by the separate ModelShelf process.
    # Do not retain metadata or directory entries for out-of-band changes.
    Attr_Expiration_Time = 0;
    DisableDirCaching = true;
    Trust_Readdir_Negative_Cache = false;

    CLIENT {
        Clients = __CLIENTS__;
        Access_Type = RO;
        Protocols = 4;
        Transports = TCP;
        SecType = sys;
    }

    FSAL {
        Name = VFS;
    }
}

LOG {
    Default_Log_Level = EVENT;
    Components {
        ALL = EVENT;
    }
    Facility {
        name = STDERR;
        destination = STDERR;
        enable = active;
    }
}
